<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">
    <!--  创建用户表结构   -->
    <changeSet id="1748008821470-1" author="bichon">
        <createTable tableName="security_principal">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="主键">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_type" type="VARCHAR(20)"/>
            <column name="auth_id" type="VARCHAR(20)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="is_super_admin" type="boolean"/>
            <column name="create_time" defaultValueComputed="CURRENT_TIMESTAMP" type="DATETIME" remarks="创建时间"/>
            <column name="update_time" type="DATETIME" remarks="更新时间"
                    defaultValueComputed="CURRENT_TIMESTAMP on update CURRENT_TIMESTAMP"/>
            <column name="version" type="BIGINT" defaultValue="0" remarks="版本"/>
        </createTable>

        <createIndex tableName="security_principal" indexName="idx_external_uuid">
            <column name="auth_id"/>
        </createIndex>
    </changeSet>

    <!-- 创建密码凭证表结构 -->
    <changeSet id="1748008821470-2" author="bichon">
        <createTable tableName="security_password_credential">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="主键">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="principal_id" type="BIGINT" remarks="关联用户ID"/>
            <column name="password" type="VARCHAR(200)" remarks="加密后的密码"/>
            <column name="create_time" defaultValueComputed="CURRENT_TIMESTAMP" type="DATETIME" remarks="创建时间"/>
            <column name="update_time" type="DATETIME" remarks="更新时间"
                    defaultValueComputed="CURRENT_TIMESTAMP on update CURRENT_TIMESTAMP"/>
            <column name="version" type="BIGINT" defaultValue="0" remarks="版本"/>
        </createTable>

        <createIndex tableName="security_password_credential" indexName="idx_principal_id">
            <column name="principal_id"/>
        </createIndex>
    </changeSet>

    <!-- 创建标识符关联表结构 -->
    <changeSet id="1748008821470-3" author="bichon">
        <createTable tableName="security_identifier">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="主键">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="password_credential_id" type="BIGINT" remarks="关联密码凭证ID">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(20)" remarks="标识符类型：USERNAME/EMAIL/PHONE"/>
            <column name="value" type="VARCHAR(200)" remarks="标识符值"/>
        </createTable>

        <createIndex tableName="security_identifier" indexName="idx_identifier_type_value" unique="true">
            <column name="type"/>
            <column name="value"/>
        </createIndex>

        <createIndex tableName="security_identifier" indexName="idx_password_credential_id">
            <column name="password_credential_id"/>
        </createIndex>
    </changeSet>

    <!-- 创建三方凭证表结构 -->
    <changeSet id="1748008821470-4" author="bichon">
        <createTable tableName="security_third_party_credential">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="主键">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="principal_id" type="BIGINT" remarks="关联用户ID"/>
            <column name="provider" type="VARCHAR(20)" remarks="第三方提供商：WECHAT/ALIPAY/GOOGLE/GITHUB"/>
            <column name="identifier" type="VARCHAR(200)" remarks="第三方标识符，如微信 openId"/>
            <column name="create_time" defaultValueComputed="CURRENT_TIMESTAMP" type="DATETIME" remarks="创建时间"/>
            <column name="update_time" type="DATETIME" remarks="更新时间"
                    defaultValueComputed="CURRENT_TIMESTAMP on update CURRENT_TIMESTAMP"/>
            <column name="version" type="BIGINT" defaultValue="0" remarks="版本"/>
        </createTable>

        <createIndex tableName="security_third_party_credential" indexName="idx_principal_id">
            <column name="principal_id"/>
        </createIndex>

        <createIndex tableName="security_third_party_credential" indexName="idx_provider_identifier" unique="true">
            <column name="provider"/>
            <column name="identifier"/>
        </createIndex>
    </changeSet>

    <!-- 创建角色、权限、权限组、角色权限关系、用户角色关系 表结构 -->
    <changeSet id="1748008844475-1" author="bichon">

        <!--创建角色表-->
        <createTable tableName="security_role">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="主键">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(40)"/>
            <column name="description" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValue="0"/>
            <column name="create_time" defaultValueComputed="CURRENT_TIMESTAMP" type="DATETIME"/>
            <column name="update_time" type="DATETIME"
                    defaultValueComputed="CURRENT_TIMESTAMP on update CURRENT_TIMESTAMP"/>
        </createTable>

        <!--创建权限表-->
        <createTable tableName="security_permission">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="主键">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="permission_group_id" type="BIGINT"/>
            <column name="code" type="VARCHAR(50)"/>
            <column name="description" type="VARCHAR(100)"/>
            <column name="version" type="BIGINT" defaultValue="0"/>
            <column name="create_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="update_time" type="DATETIME"
                    defaultValueComputed="CURRENT_TIMESTAMP on update CURRENT_TIMESTAMP"/>
        </createTable>

        <!--创建权限组表-->
        <createTable tableName="security_permission_group">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="主键">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(50)"/>
            <column name="description" type="VARCHAR(100)"/>
            <column name="sort_order" type="INT"/>
            <column name="create_time" defaultValueComputed="CURRENT_TIMESTAMP" type="TIMESTAMP"/>
            <column defaultValueComputed="CURRENT_TIMESTAMP on update CURRENT_TIMESTAMP" name="update_time"
                    type="TIMESTAMP"/>
        </createTable>

        <sql>
            INSERT INTO security_permission_group (id, name, description, sort_order)
            VALUES (1, '系统管理', '用户管理相关权限', 1);
            INSERT INTO security_permission_group (id, name, description, sort_order)
            VALUES (2, '用户管理', '用户管理相关权限', 2);
            INSERT INTO security_permission_group (id, name, description, sort_order)
            VALUES (3, '部门管理', '部门管理相关权限', 3);
            INSERT INTO security_permission_group (id, name, description, sort_order)
            VALUES (4, '部门查询', '部门管理相关权限', 4);
        </sql>
    </changeSet>

    <!--创建角色权限关系表-->
    <changeSet id="1748008844475-2" author="bichon">
        <createTable tableName="security_role_permission">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="主键">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="role_id" type="BIGINT" remarks="角色id"/>
            <column name="permission_id" type="BIGINT" remarks="权限id"/>
            <column name="create_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column defaultValueComputed="CURRENT_TIMESTAMP on update CURRENT_TIMESTAMP" name="update_time"
                    type="DATETIME"/>
        </createTable>

        <sql>
            INSERT INTO security_role_permission (id, role_id, permission_id)
            VALUES (1, 1, 1);
            INSERT INTO security_role_permission (id, role_id, permission_id)
            VALUES (2, 1, 2);
            INSERT INTO security_role_permission (id, role_id, permission_id)
            VALUES (3, 1, 3);
            INSERT INTO security_role_permission (id, role_id, permission_id)
            VALUES (4, 1, 4);
        </sql>
    </changeSet>

    <!--创建用户角色关系表-->
    <changeSet id="1748008844475-3" author="bichon">
        <createTable tableName="security_principal_role">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="主键">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="principal_id" type="BIGINT" remarks="用户id"/>
            <column name="role_id" type="BIGINT" remarks="角色id"/>
            <column name="create_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column defaultValueComputed="CURRENT_TIMESTAMP on update CURRENT_TIMESTAMP" name="update_time"
                    type="DATETIME"/>
        </createTable>

        <sql>
            INSERT INTO security_principal_role (id, principal_id, role_id)
            VALUES (1, 1, 1);
        </sql>
    </changeSet>

    <!-- 插入基础权限数据 -->
    <changeSet id="1748008844475-4" author="bichon">
        <sql>
            INSERT INTO security_permission (id, name, permission_group_id, code, description)
            VALUES (1, '用户查询', 2, 'manager:user:read', '查询用户权限');
            INSERT INTO security_permission (id, name, permission_group_id, code, description)
            VALUES (2, '用户查询', 2, 'manager:user:write', '管理用户权限');
            INSERT INTO security_permission (id, name, permission_group_id, code, description)
            VALUES (3, '部门查询', 4, 'manager:department:read', '查询部门权限');
            INSERT INTO security_permission (id, name, permission_group_id, code, description)
            VALUES (4, '部门查询', 4, 'manager:department:write', '管理部门权限');
        </sql>
    </changeSet>
</databaseChangeLog>